# Copy to .env; Docker Compose reads .env for variable substitution.
# Never commit your real keys. These values are optional for offline usage.
GROQ_API_KEY=
OPENAI_API_KEY=

# Local-only browser port (http://localhost:8501 by default).
STREAMLIT_PORT=8501

# Default Docker host connection to locally installed Ollama.
# Set to another reachable Ollama HTTP URL only if required.
# OLLAMA_HOST=http://host.docker.internal:11434
